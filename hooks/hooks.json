{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "UV_PROJECT_ENVIRONMENT=\"${CLAUDE_PLUGIN_DATA:-$HOME/.cache/memtegrity}/venv\" uv run --quiet --project \"${CLAUDE_PLUGIN_ROOT}\" memtegrity hook session-start",
            "timeout": 600
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "UV_PROJECT_ENVIRONMENT=\"${CLAUDE_PLUGIN_DATA:-$HOME/.cache/memtegrity}/venv\" uv run --quiet --project \"${CLAUDE_PLUGIN_ROOT}\" memtegrity hook user-prompt-submit",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "UV_PROJECT_ENVIRONMENT=\"${CLAUDE_PLUGIN_DATA:-$HOME/.cache/memtegrity}/venv\" uv run --quiet --project \"${CLAUDE_PLUGIN_ROOT}\" memtegrity hook pre-tool-use",
            "timeout": 300
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "UV_PROJECT_ENVIRONMENT=\"${CLAUDE_PLUGIN_DATA:-$HOME/.cache/memtegrity}/venv\" uv run --quiet --project \"${CLAUDE_PLUGIN_ROOT}\" memtegrity hook pre-tool-use",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "UV_PROJECT_ENVIRONMENT=\"${CLAUDE_PLUGIN_DATA:-$HOME/.cache/memtegrity}/venv\" uv run --quiet --project \"${CLAUDE_PLUGIN_ROOT}\" memtegrity hook pre-tool-use",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "UV_PROJECT_ENVIRONMENT=\"${CLAUDE_PLUGIN_DATA:-$HOME/.cache/memtegrity}/venv\" uv run --quiet --project \"${CLAUDE_PLUGIN_ROOT}\" memtegrity hook post-tool-use",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "UV_PROJECT_ENVIRONMENT=\"${CLAUDE_PLUGIN_DATA:-$HOME/.cache/memtegrity}/venv\" uv run --quiet --project \"${CLAUDE_PLUGIN_ROOT}\" memtegrity hook post-tool-use",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "UV_PROJECT_ENVIRONMENT=\"${CLAUDE_PLUGIN_DATA:-$HOME/.cache/memtegrity}/venv\" uv run --quiet --project \"${CLAUDE_PLUGIN_ROOT}\" memtegrity hook post-tool-use",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "UV_PROJECT_ENVIRONMENT=\"${CLAUDE_PLUGIN_DATA:-$HOME/.cache/memtegrity}/venv\" uv run --quiet --project \"${CLAUDE_PLUGIN_ROOT}\" memtegrity hook post-tool-use",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "UV_PROJECT_ENVIRONMENT=\"${CLAUDE_PLUGIN_DATA:-$HOME/.cache/memtegrity}/venv\" uv run --quiet --project \"${CLAUDE_PLUGIN_ROOT}\" memtegrity hook post-tool-use",
            "timeout": 60
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "UV_PROJECT_ENVIRONMENT=\"${CLAUDE_PLUGIN_DATA:-$HOME/.cache/memtegrity}/venv\" uv run --quiet --project \"${CLAUDE_PLUGIN_ROOT}\" memtegrity hook file-changed"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "UV_PROJECT_ENVIRONMENT=\"${CLAUDE_PLUGIN_DATA:-$HOME/.cache/memtegrity}/venv\" uv run --quiet --project \"${CLAUDE_PLUGIN_ROOT}\" memtegrity hook config-change"
          }
        ]
      }
    ]
  }
}
